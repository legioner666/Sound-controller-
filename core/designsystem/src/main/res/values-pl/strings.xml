    <string name="onb_welcome_title">Witamy w Sonic Control</string>
    <string name="onb_welcome_body">Jedna aplikacja dla słuchawek wielu marek. Pokazuje dokładnie, co działa z Twoim modelem — bez udawania.</string>
    <string name="onb_statuses_title">Co oznaczają etykiety</string>
    <string name="onb_status_verified">przetestowane przez projekt na prawdziwych słuchawkach</string>
    <string name="onb_status_supported">zbudowane na protokole potwierdzonym na sprzęcie</string>
    <string name="onb_status_experimental">wymaga testów; wyłączone, dopóki nie włączysz</string>
    <string name="onb_status_basic">standardowe funkcje Androida, dowolne słuchawki</string>
    <string name="onb_status_unsupported">niedostępne; element wyłączony</string>
    <string name="onb_permission_title">Urządzenia w pobliżu</string>
    <string name="onb_permission_body">Sonic Control potrzebuje uprawnienia Bluetooth, aby znaleźć słuchawki i z nimi rozmawiać. Nigdy nie służy do ustalania lokalizacji.</string>
    <string name="onb_permission_ok">Bluetooth jest gotowy.</string>
    <string name="onb_connect_title">Twoje słuchawki</string>
    <string name="onb_connect_body">Najpierw połącz słuchawki w Androidzie, a potem wybierz je tutaj.</string>
    <string name="onb_connect_none">Obecnie żadne słuchawki nie są połączone dla dźwięku. Możesz to zrobić później na karcie „Urządzenia”.</string>
    <string name="onb_connected_as">%1$s — sterownik: %2$s</string>
    <string name="onb_diagnostics_hint">Nie rozpoznano lub nie działa? Laboratorium → Diagnostyka pokaże, co oferują słuchawki, i zapisze anonimowy raport.</string>
