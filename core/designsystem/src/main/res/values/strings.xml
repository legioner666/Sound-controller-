    <string name="onb_status_verified">tested on real headphones by this project</string>
    <string name="onb_status_supported">built on a protocol confirmed on real hardware</string>
    <string name="onb_status_experimental">needs testing; off until you enable it</string>
    <string name="onb_status_basic">standard Android functions, any headphones</string>
    <string name="onb_status_unsupported">not available; the control is disabled</string>
    <string name="onb_permission_title">Nearby devices</string>
    <string name="onb_permission_body">Sonic Control needs the Bluetooth permission to find and talk to your headphones. It is never used to determine your location.</string>
