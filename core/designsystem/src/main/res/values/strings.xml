    <string name="settings_experimental">Experimental features</string>
    <string name="settings_experimental_body">Allows commands confirmed only on related models. Destructive commands stay blocked.</string>
    <string name="experimental_dialog_title">Enable experimental features?</string>
    <string name="experimental_dialog_body">These commands come from protocol research and were not tested on your model. Firmware updates, factory resets and pairing changes are never sent. Results are shown only when the headset confirms them.</string>
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_body">No account, no ads, no analytics and no internet access. Settings, profiles and battery history stay on this phone.</string>
    <string name="settings_about">About</string>
    <string name="settings_version">Version %1$s</string>
    <string name="advice_no_endpoint_title">Control channel not found</string>
    <string name="advice_no_endpoint">The headphones play sound, but they do not answer on any Bluetooth LE address that Sonic Control could find. Many earbuds only open the control channel when the case lid is closed and reopened, or when the manufacturer’s app is closed.</string>
    <string name="advice_refused_title">Headphones refused the connection</string>
    <string name="advice_refused">The headphones answered but closed the control connection. Close the manufacturer’s app and try again.</string>
    <string name="advice_no_services_title">No usable services</string>
    <string name="advice_no_services">The connection opened, but the headphones expose no services Sonic Control can use.</string>
    <string name="advice_unavailable_title">No control for these headphones yet</string>
    <string name="advice_unavailable">Sound and volume work through Android. Features of the headphones themselves need a confirmed protocol. Open Lab to send a diagnostic report.</string>
    <string name="advice_waiting">Looking for the control channel…</string>
    <string name="advice_steps">1. Close the manufacturer’s app.
2. Put the earbuds in the case for 5 seconds, then take them out.
3. Tap Try again.</string>
